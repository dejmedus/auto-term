{
  "setup": [
    {
      "tab": "git",
      "commands": ["git branch"],
      "icon": "git"
    },
    {
      "tab": "frontend",
      "commands": ["npm install"],
      "icon": "browser"
    }
  ],
  "open": [
    {
      "tab": "git",
      "commands": ["git branch"],
      "icon": "git"
    },
    {
      "tab": "frontend",
      "commands": ["npm run dev"],
      "icon": "browser"
    }
  ],
  "start": [
    {
